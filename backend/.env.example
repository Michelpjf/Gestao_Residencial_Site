NODE_ENV=development
PORT=3000
TRUST_PROXY=false

# PostgreSQL connection string. Keep the real value in the environment/secret store.
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/bueno_residence
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

# Public Supabase project URL. JWT keys are discovered from the project's JWKS endpoint.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_JWT_AUDIENCE=authenticated
